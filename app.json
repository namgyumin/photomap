{
  "expo": {
    "name": "PhotoMap",
    "slug": "photomap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/branding/app-icon.png",
    "userInterfaceStyle": "automatic",
    "scheme": "photomap",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.namgyumin.photomap",
      "config": {
        "googleMapsApiKey": "$(GOOGLE_MAPS_API_KEY)"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/adaptive-icon-foreground.png",
        "backgroundImage": "./assets/branding/adaptive-icon-background.png",
        "monochromeImage": "./assets/branding/adaptive-icon-monochrome.png"
      },
      "package": "com.namgyumin.photomap",
      "config": {
        "googleMaps": {
          "apiKey": "$(GOOGLE_MAPS_API_KEY)"
        }
      }
    },
    "web": {
      "favicon": "./assets/branding/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-web-browser",
      "expo-video",
      [
        "react-native-maps",
        {
          "googleMapsApiKey": "$(GOOGLE_MAPS_API_KEY)"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "장소를 추천하기 위해 현재 위치를 사용합니다.",
          "locationAlwaysAndWhenInUsePermission": "장소를 추천하기 위해 현재 위치를 사용합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "오늘 간 장소에 사진을 추가하기 위해 사진 라이브러리에 접근합니다."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "기록한 사진과 영상을 기기에서 바로 보여주기 위해 사진 라이브러리에 접근합니다."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1579879380097498~1004491874"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "58272f54-4da0-4e10-9f79-1378237f3cf2"
      }
    }
  }
}
